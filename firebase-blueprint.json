{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "guardian", "trainer", "administrator"] },
        "assignedSeatEmail": { "type": "string", "format": "email" }
      },
      "required": ["uid", "email", "role"]
    },
    "License": {
      "title": "License",
      "description": "License management with referral codes.",
      "type": "object",
      "properties": {
        "licenseKey": { "type": "string" },
        "referralCode": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string", "format": "email" },
        "ownerMoniker": { "type": "string" },
        "tier": { "type": "string" },
        "totalSeats": { "type": "integer" },
        "usedSeats": { "type": "integer" },
        "clicks": { "type": "integer" },
        "assignedMembers": { "type": "array" },
        "referredUsers": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["licenseKey", "referralCode", "ownerUid", "totalSeats"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/licenses/{licenseKey}": {
      "schema": "License",
      "description": "License management."
    }
  }
}
